{
  "name": "template-bun-ts",
  "private": true,
  "module": "src/index.ts",
  "type": "module",
  "version": "0.0.1",
  "imports": {
    "#src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "dotenvx run -f .env.development -fk .env -- bun run --watch src/index.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "bun test",
    "env:encrypt": "dotenvx encrypt -f .env.* -fk .env",
    "env:decrypt": "dotenvx decrypt -f .env.* -fk .env",
    "depscheck": "knip"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.71.0"
  },
  "devDependencies": {
    "@total-typescript/ts-reset": "0.6.1",
    "@tsconfig/bun": "1.0.10",
    "@tsconfig/strictest": "2.0.8",
    "@types/bun": "1.4.3",
    "@types/node": "25.9.2",
    "@yoshintame/ox-config": "0.2.0",
    "knip": "6.16.0",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "6.0.3"
  }
}
